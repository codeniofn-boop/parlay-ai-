{
  "_comment": "EdgeBook AI market registry. The four game markets (spread, total, moneyline, team_total) are built in. Every player-prop market is an entry under prop_markets: to add a new prop type, add an entry here and it flows through props_inputs.csv, the finder, the report, the dashboard and the backtester with no code change. Per-market qualification thresholds live in pipeline_config.json under finder.market_rules.",
  "_fields": {
    "label": "Shown on screen and used in the selection text, e.g. 'Dak Prescott Over 264.5 Passing Yards'.",
    "aliases": "Other spellings accepted in the market column of props_inputs.csv (case and spacing do not matter).",
    "kind": "over_under (a line with Over/Under prices) or yes_no (a single Yes price, optional No price).",
    "parts": "Which nflverse stat columns are projected and which usage column (attempts, carries, targets) drives each; several parts are summed, e.g. rush + receiving yards.",
    "distribution": "How the projection becomes a probability: normal | gamma (skewed, zero-floored yards) | negbin (overdispersed counts) | poisson (rare counts; yes_no markets use P(at least one)).",
    "sd_intercept, sd_slope": "Spread of the projection as a + b x mean, for normal and gamma markets.",
    "dispersion": "negbin only: variance = mean + mean^2 / dispersion (smaller = more spread).",
    "rate_pseudo": "Pseudo-count that shrinks a player's per-usage rate toward the league positional rate; overrides model.rate_pseudo_counts for this market.",
    "families": "Stat families the correlation table uses to reject double-counting: two legs on the same player that share a family are redundant.",
    "cls": "Market class referenced by correlation_rules.json.",
    "positions": "Positions that normally carry this market; used for the league prior and for messages only.",
    "high_variance": "true adds model.high_variance_extra_gap to the required edge and shows a warning.",
    "experimental": "true keeps the EXPERIMENTAL badge on this market until the backtest calibration gate clears it."
  },
  "model": {
    "_comment": "Prop projection settings. usage = recent-weighted per-game attempts/carries/targets; rate = stat per usage, shrunk toward the league positional rate; opponent and game-script factors multiply the mean.",
    "decay": 0.75,
    "prior_season_weight": 0.35,
    "min_games": 2,
    "usage_prior_games": 3,
    "rate_pseudo_counts": {
      "attempts": 150,
      "carries": 60,
      "targets": 40
    },
    "opponent_shrink": 0.5,
    "opponent_clamp": [
      0.75,
      1.25
    ],
    "script": {
      "_comment": "Pass volume rises for underdogs and rush volume rises for favourites, per point of spread; total volume scales with the posted total relative to league_total.",
      "pass_per_point": 0.012,
      "rush_per_point": 0.015,
      "total_elasticity": 0.5,
      "league_total": 45.0
    },
    "usage_play_type": {
      "attempts": "pass",
      "targets": "pass",
      "carries": "rush"
    },
    "first_td_team_factor": 0.6,
    "high_variance_extra_gap": 0.02,
    "block_injury_status": [
      "Out",
      "Doubtful"
    ],
    "_calibration": "Spread parameters were tuned on the 2025 walk-forward calibration (python3 prop_model.py --calibrate --season 2025): dispersion ratios of 1.14 (passing yards), 1.21 (completions), 0.91 (receiving yards), 0.94 (receptions) and 1.08 (rushing attempts) pointed at these values. Re-run after changing anything here."
  },
